# Normalise line endings in the repository to LF.
#
# This package is developed on Windows and run on Linux (GitHub Actions). With
# CRLF in the blob, `bash run_all.sh` dies on its second line: the parser reads
# `set -euo pipefail\r` and rejects "pipefail\r" as an invalid option name. The
# same applies to `run:` blocks in the workflow and to every script here.

* text=auto eol=lf

*.sh    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.tsv   text eol=lf
*.cff   text eol=lf
*.txt   text eol=lf
*.log   text eol=lf

# Binary payloads must not be touched.
*.rds   binary
*.RDS   binary
*.png   binary
*.tif   binary
*.tiff  binary
*.pdf   binary
*.docx  binary
