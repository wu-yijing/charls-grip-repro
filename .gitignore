# --- manuscripts and submission documents: never commit --------------------
# The manuscript, cover letter, highlights, response letters and reviewer
# correspondence are not part of the reproducibility package and must not be
# published. `git check-ignore -v manuscript.docx` should echo a line from here.
*.docx
*.doc
*.pdf
*.tex
*.rtf
*.odt
manuscript/
submission/
cover*/
response*/
review*/
_archive/
~$*
*.docx.bak
*.orig_bak

# --- data that must never be committed -------------------------------------
*.dta
*.DTA
*.sav
*.sas7bdat
*.xpt
*.parquet
*.feather
data/raw_synthetic/
data/derived/

# --- generated outputs -----------------------------------------------------
out/
logs/
figures/*
!figures/.gitkeep

# --- R / Python ------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
.Renviron
__pycache__/
*.pyc
.venv/
renv/library/

# --- editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
_supp.md
logs_summary.txt
data/
